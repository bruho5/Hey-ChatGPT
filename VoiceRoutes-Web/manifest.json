{
  "manifest_version": 3,
  "name": "Hey, ChatGPT (Desktop Link)",
  "version": "0.3.0",
  "description": "Chrome connection for the Hey, ChatGPT Windows tray app.",
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "打开 Hey, ChatGPT"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  }
}
